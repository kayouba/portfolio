---
import type { CertificationsContent } from '../content/types';

interface Props {
  certifications: CertificationsContent;
}
const { certifications } = Astro.props;
---

<section id="certifications" class="section">
  <div class="container">
    <h2 class="section-heading">{certifications.title}</h2>
    <p class="section-intro">{certifications.intro}</p>
    <h3 class="cert-subtitle">{certifications.obtainedTitle}</h3>
    <div class="cert-grid">
      {certifications.obtained.map((c) => (
        <div class="cert-item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M9 13l-2 8 5-3 5 3-2-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
          <h4>{c.title}</h4>
          <p>{c.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cert-subtitle {
    font-size: 1.1rem;
    margin-bottom: 1.25rem;
  }
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }
  .cert-item {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem;
    text-align: center;
  }
  .cert-item svg {
    width: 2rem;
    height: 2rem;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }
  .cert-item h4 {
    font-size: 1rem;
    margin-bottom: 0.3rem;
  }
  .cert-item p {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
</style>
