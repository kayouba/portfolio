---
import type { HeroContent } from '../content/types';

interface Props {
  hero: HeroContent;
}
const { hero } = Astro.props;
---

<section class="hero">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="container hero-inner">
    <span class="hero-eyebrow">{hero.eyebrow}</span>
    <h1>{hero.title}</h1>
    <p class="hero-role">
      <span class="role-text" data-roles={JSON.stringify(hero.roles)}>{hero.roles[0]}</span>
    </p>
    <p class="hero-description">{hero.description}</p>
    <div class="hero-cta">
      <a href="#projects" class="btn btn-primary">{hero.ctaPrimary}</a>
      <a href="#contact" class="btn btn-secondary">{hero.ctaSecondary}</a>
    </div>
    <ul class="hero-signals">
      {hero.signals.map((s) => (
        <li><strong>{s.label}</strong><span>{s.value}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 7rem 0 5rem;
    overflow: hidden;
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 15% 20%, rgba(57, 135, 229, 0.16), transparent 45%),
      radial-gradient(circle at 85% 0%, rgba(25, 158, 112, 0.12), transparent 40%);
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    max-width: 760px;
  }
  .hero-eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1.5rem;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    margin-bottom: 0.5rem;
  }
  .hero-role {
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    color: var(--color-text-secondary);
    font-weight: 600;
    margin-bottom: 1.5rem;
    min-height: 2rem;
  }
  .role-text {
    color: var(--color-accent-hover);
  }
  .hero-description {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    max-width: 620px;
    margin-bottom: 2.25rem;
  }
  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }
  .hero-signals {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    list-style: none;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
  }
  .hero-signals li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .hero-signals strong {
    font-size: 0.95rem;
  }
  .hero-signals span {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .hero { padding: 5.5rem 0 3.5rem; }
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('.role-text');
  if (el) {
    const roles: string[] = JSON.parse(el.dataset.roles || '[]');
    let i = 0;
    setInterval(() => {
      i = (i + 1) % roles.length;
      el.style.opacity = '0';
      setTimeout(() => {
        el.textContent = roles[i];
        el.style.opacity = '1';
      }, 220);
    }, 2600);
    el.style.transition = 'opacity 0.22s ease';
  }
</script>
