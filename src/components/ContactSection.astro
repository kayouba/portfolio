---
import type { ContactContent } from '../content/types';

interface Props {
  contact: ContactContent;
}
const { contact } = Astro.props;
---

<section id="contact" class="section">
  <div class="container">
    <h2 class="section-heading">{contact.title}</h2>
    <p class="section-intro">{contact.intro}</p>

    <div class="contact-grid">
      <div class="contact-info">
        <h3>{contact.connectTitle}</h3>
        <p>{contact.connectText}</p>
        <div class="contact-methods">
          {contact.methods.map((m) => (
            <a href={m.href} target={m.href.startsWith('http') ? '_blank' : undefined} rel="noopener" class="contact-method">
              <span class="method-label">{m.label}</span>
              <span class="method-value">{m.value}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="contact-cta">
        <h3>{contact.ctaTitle}</h3>
        <p>{contact.ctaText}</p>
        <a href={contact.methods[0].href} class="btn btn-primary large">{contact.ctaButton}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .contact-info,
  .contact-cta {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 2rem;
  }
  .contact-info h3,
  .contact-cta h3 {
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
  }
  .contact-info p,
  .contact-cta p {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }
  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .contact-method {
    display: flex;
    justify-content: space-between;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    transition: var(--transition);
  }
  .contact-method:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }
  .method-label {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
  .method-value {
    font-weight: 600;
    font-size: 0.9rem;
  }
  .btn.large {
    padding: 1rem 1.75rem;
    font-size: 1rem;
  }

  @media (max-width: 780px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
