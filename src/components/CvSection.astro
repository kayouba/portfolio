---
import type { CvContent } from '../content/types';

interface Props {
  cv: CvContent;
}
const { cv } = Astro.props;
---

<section id="cv" class="section">
  <div class="container">
    <h2 class="section-heading">{cv.title}</h2>
    <p class="section-intro">{cv.intro}</p>
    <div class="cv-card">
      <div>
        <h3>{cv.cardTitle}</h3>
        <p>{cv.cardText}</p>
      </div>
      <div class="cv-links">
        <a class="btn btn-secondary" href="/Kayou_BA_CV.pdf" target="_blank" rel="noopener">{cv.frLabel}</a>
        <a class="btn btn-secondary" href="/Kayou_BA_Resume.pdf" target="_blank" rel="noopener">{cv.enLabel}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cv-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .cv-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }
  .cv-card p {
    color: var(--color-text-secondary);
    font-size: 0.92rem;
  }
  .cv-links {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
</style>
