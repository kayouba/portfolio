---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHero from '../../components/ProjectHero.astro';
import { siteFr } from '../../content/site.fr';
import { cdm2026Fr as p } from '../../content/projects/cdm2026.fr';
import { ui } from '../../content/ui';

const locale = 'fr' as const;
const t = ui[locale].charts;

const statusIcon: Record<string, string> = {
  good: 'M5 12l4 4 10-10',
  warning: 'M6 12h12',
  critical: 'M6 6l12 12M18 6l-12 12',
};
const statusColorVar: Record<string, string> = {
  good: 'var(--status-good)',
  warning: 'var(--status-warning)',
  critical: 'var(--status-critical)',
};
---

<BaseLayout
  locale={locale}
  title={`${p.title} | Kayou Ba`}
  description={p.subtitle}
  nav={siteFr.nav}
  footer={siteFr.footer}
  altHref="/en/projects/world-cup-2026/"
  canonicalPath="/projets/cdm-2026/"
>
  <ProjectHero
    backLabel={ui[locale].back}
    backHref="/#projects"
    eyebrow={p.eyebrow}
    title={p.title}
    subtitle={p.subtitle}
    stats={p.heroStats.map((s) => ({ value: s.value, label: s.label }))}
  />

  <main class="container">
    <section class="project-section">
      <span class="kicker">{p.context.title}</span>
      <h2>{p.context.heading}</h2>
      {p.context.paragraphs.map((para) => <p>{para}</p>)}
    </section>

    <section class="project-section">
      <span class="kicker">{p.result.title}</span>
      <h2>{p.result.heading}</h2>
      <p>{p.result.intro}</p>

      <div class="chart">
        {p.result.bars.map((bar) => (
          <div class="chart-row">
            <span class="chart-row-label">
              <svg class="chart-icon" viewBox="0 0 24 24" fill="none" stroke={statusColorVar[bar.status]} stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                <path d={statusIcon[bar.status]} />
              </svg>
              <span>{bar.points} <span style="color:var(--color-text-muted)">({bar.detail})</span></span>
            </span>
            <div class="chart-track">
              <div class="chart-fill" style={`width:${bar.probability}%; background:${statusColorVar[bar.status]}`}></div>
            </div>
            <span class="chart-value">{bar.probability}%</span>
          </div>
        ))}
      </div>
      <p class="chart-caption">{t.probability} · {p.source}</p>

      <p>{p.result.conclusion}</p>
    </section>

    <section class="project-section">
      <span class="kicker">{p.method.title}</span>
      <h2>{p.method.heading}</h2>
      <p>{p.method.intro}</p>
      <div class="step-grid">
        {p.method.steps.map((step, i) => (
          <div class="step-card">
            <span class="step-number">{String(i + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="project-section">
      <span class="kicker">{p.reflection.title}</span>
      <h2>{p.reflection.heading}</h2>
      <div class="callout">
        <p>{p.reflection.text}</p>
      </div>
    </section>

    <section class="project-section">
      <span class="kicker">{p.stackTitle}</span>
      <div class="tag-row">
        {p.stack.map((s) => <span class="tag">{s}</span>)}
      </div>
    </section>

    <div class="project-cta">
      <a class="btn btn-primary" href={p.githubUrl} target="_blank" rel="noopener">{p.ctaLabel}</a>
      <a class="btn btn-secondary" href="/#projects">{ui[locale].back}</a>
    </div>
  </main>
</BaseLayout>
