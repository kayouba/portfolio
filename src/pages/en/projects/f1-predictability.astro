---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectHero from '../../../components/ProjectHero.astro';
import { siteEn } from '../../../content/site.en';
import { f1En as p } from '../../../content/projects/f1.en';
import { ui } from '../../../content/ui';

const locale = 'en' as const;
---

<BaseLayout
  locale={locale}
  title={`${p.title} | Kayou Ba`}
  description={p.subtitle}
  nav={siteEn.nav}
  footer={siteEn.footer}
  altHref="/projets/f1-predictibilite/"
  canonicalPath="/en/projects/f1-predictability/"
>
  <ProjectHero
    backLabel={ui[locale].back}
    backHref="/en/#projects"
    eyebrow={p.eyebrow}
    title={p.title}
    subtitle={p.subtitle}
    stats={p.heroStats.map((s) => ({ value: s.value, label: s.label }))}
  />

  <main class="container">
    <div class="disclaimer">{p.disclaimer}</div>

    <section class="project-section">
      <span class="kicker">{p.context.title}</span>
      <h2>{p.context.heading}</h2>
      {p.context.paragraphs.map((para) => <p>{para}</p>)}
    </section>

    <section class="project-section">
      <span class="kicker">{p.index.title}</span>
      <h2>{p.index.heading}</h2>
      <p>{p.index.intro}</p>
      <div class="formula-box">{p.index.formula}</div>
      <div class="component-list">
        {p.index.components.map((c) => (
          <div class="component-row">
            <span>{c.label}</span>
            <span class="component-weight">{c.weight}</span>
            <span class="component-value">{c.value}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="project-section">
      <span class="kicker">{p.eras.title}</span>
      <h2>{p.eras.heading}</h2>
      <p>{p.eras.intro}</p>

      <table class="era-table">
        <thead>
          <tr>
            <th>{p.eras.tableHeaders.metric}</th>
            <th>{p.eras.tableHeaders.golden}</th>
            <th>{p.eras.tableHeaders.crisis}</th>
          </tr>
        </thead>
        <tbody>
          {p.eras.metrics.map((m) => (
            <tr>
              <td>{m.label}</td>
              <td>{m.golden}</td>
              <td>{m.crisis}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <div class="chart">
        <div class="chart-legend">
          <span class="chart-legend-item"><span class="chart-swatch" style="background:var(--series-1)"></span>{p.eras.tableHeaders.golden}</span>
          <span class="chart-legend-item"><span class="chart-swatch" style="background:var(--series-2)"></span>{p.eras.tableHeaders.crisis}</span>
        </div>
        {p.eras.overtakingChart.bars.map((bar, i) => (
          <div class="chart-row">
            <span class="chart-row-label">{bar.label}</span>
            <div class="chart-track">
              <div class="chart-fill" style={`width:${(bar.value / bar.max) * 100}%; background:${i === 0 ? 'var(--series-1)' : 'var(--series-2)'}`}></div>
            </div>
            <span class="chart-value">{bar.value}</span>
          </div>
        ))}
        <p class="chart-caption">{p.eras.overtakingChart.caption}</p>
      </div>

      <div class="chart">
        {p.eras.poleChart.bars.map((bar, i) => (
          <div class="chart-row">
            <span class="chart-row-label">{bar.label}</span>
            <div class="chart-track">
              <div class="chart-fill" style={`width:${(bar.value / bar.max) * 100}%; background:${i === 0 ? 'var(--series-1)' : 'var(--series-2)'}`}></div>
            </div>
            <span class="chart-value">{bar.value}%</span>
          </div>
        ))}
        <p class="chart-caption">{p.eras.poleChart.caption}</p>
      </div>
    </section>

    <section class="project-section">
      <span class="kicker">{p.reg2026.title}</span>
      <h2>{p.reg2026.heading}</h2>
      <p>{p.reg2026.intro}</p>
      <div class="change-grid">
        {p.reg2026.changes.map((c) => (
          <div class="change-card">
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </div>
        ))}
      </div>
      <div class="callout">
        <p>{p.reg2026.caveat}</p>
      </div>
    </section>

    <section class="project-section">
      <span class="kicker">{p.stackTitle}</span>
      <div class="tag-row">
        {p.stack.map((s) => <span class="tag">{s}</span>)}
      </div>
    </section>

    <div class="project-cta">
      <a class="btn btn-primary" href={p.dashboardUrl} target="_blank" rel="noopener">{p.dashboardLabel}</a>
      <a class="btn btn-secondary" href={p.githubUrl} target="_blank" rel="noopener">{p.ctaLabel}</a>
      <a class="btn btn-ghost" href="/en/#projects">{ui[locale].back}</a>
    </div>
  </main>
</BaseLayout>
